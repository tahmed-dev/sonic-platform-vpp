+	  if (arp0->opcode == clib_host_to_net_u16 (ETHERNET_ARP_OPCODE_reply) ||
+	      arp0->opcode == clib_host_to_net_u16 (ETHERNET_ARP_OPCODE_request))
 	    {
 	      lcp_itf_pair_t *lip0 = 0;
 	      u32 lipi0;
@@ -854,6 +869,7 @@ VLIB_NODE_FN (lcp_arp_phy_node)
