+/*
+ * Mask of stale flags to clear on ARP clone buffers before sending
+ * to host tap.  Packets arriving via VxLAN (or other encap) have
+ * outer-IP flags set; if these survive into the clone the virtio-net
+ * TX sets up a corrupt vnet_hdr and the kernel silently drops the
+ * frame.
+ */
+#define LCP_ARP_CLONE_CLEAR_FLAGS                                             \
+  (VNET_BUFFER_F_IS_IP4 | VNET_BUFFER_F_IS_IP6 |                             \
+   VNET_BUFFER_F_L4_CHECKSUM_COMPUTED | VNET_BUFFER_F_L4_CHECKSUM_CORRECT |   \
+   VNET_BUFFER_F_L3_HDR_OFFSET_VALID | VNET_BUFFER_F_L4_HDR_OFFSET_VALID |   \
+   VNET_BUFFER_F_OFFLOAD | VNET_BUFFER_F_GSO | VLIB_BUFFER_EXT_HDR_VALID)
+
 #define foreach_lip_punt                                                      \
   _ (IO, "punt to host")                                                      \
   _ (DROP, "unknown input interface")
